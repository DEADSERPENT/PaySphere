# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://paysphere:paysphere@localhost:5433/paysphere
DATABASE_POOL_MAX=10

# Test database (used by integration/failure-injection tests)
TEST_DATABASE_URL=postgres://paysphere:paysphere@localhost:5433/paysphere_test

# Razorpay (test mode keys from the Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to "mock" to use the in-memory gateway adapter instead of calling Razorpay.
# Useful for local development and for the test suite.
GATEWAY_ADAPTER=mock

# Idempotency
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_MS=30000

# Reconciliation
RECONCILIATION_STUCK_PENDING_MINUTES=15
RECONCILIATION_STUCK_PROCESSING_MINUTES=30
RECONCILIATION_INTERVAL_MS=60000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
